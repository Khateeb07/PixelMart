<%-- any content can be specified here e.g.: --%>
<%@ page pageEncoding="UTF-8" %>
<div id="header" class="bg-dark py-2">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-10 row">

                <!-- Logo + Title -->
                <div class="col-md-3 d-flex align-items-center text-light">
                    <img src="${pageContext.request.contextPath}/images/logos/logo.png" 
                         width="70"
                         height="70"
                         class="ms-5 rounded"
                         alt="logo">
                    <a 
                        href="welcome"
                        class="mb-0 h3 ms-3 text-light text-decoration-none logo-link" >

                        Pixel Mart

                    </a>
                </div>
            </div>



            <!-- Navigation Bar Button -->
            <div class="col-md-2 text-center"
                 id="navbutton">
            </div>
        </div>
    </div>
</div>