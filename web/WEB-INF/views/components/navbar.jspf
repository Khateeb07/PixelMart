<div class="bg-dark py-2 border-bottom border-secondary sticky-top">

    <div class="container">

        <div class="row align-items-center">

            <!-- Logo -->

            <div class="col-lg-3 d-flex align-items-center">

                <img
                    src="${pageContext.request.contextPath}/images/logos/logo.png"
                    width="55"
                    height="55"
                    class="rounded"
                    alt="logo">

                <a
                    href="welcome"
                    class="h4 mb-0 ms-3 text-light text-decoration-none logo-link">

                    Pixel Mart

                </a>

            </div>

            <!-- Search -->

            <div class="col-lg-6">

                <div class="input-group">

                    <input
                        type="text"
                        class="form-control shadow-none border-0"
                        placeholder="Search products...">

                    <button
                        class="btn btn-primary">

                        <i class="bi bi-search"></i>

                    </button>

                </div>

            </div>

            <!-- Buttons -->

            <div
                class="col-lg-3 text-end"
                id="navbutton">

            </div>

        </div>

    </div>

</div>